# Copy to .env.local (git-ignored).
# hok-web never talks to Supabase directly -- all auth and data access goes
# through hok-api. Ports: web 3400, API 4100 (needleye uses 3000/4000, so both
# projects can run on one machine).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4100/api/v1
# This app's own public origin -- used to build absolute links (e.g. a client's
# portal link, /p/<token>) that must resolve when opened on another device.
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3400

# Server-only (never NEXT_PUBLIC_): the same value as hok-api's INTERNAL_PROXY_SECRET.
# Lets hok-api trust the visitor IP this server forwards (login, refresh, Server Components),
# so each visitor gets their own rate-limit bucket. REQUIRED in production.
INTERNAL_PROXY_SECRET=
