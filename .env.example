NODE_ENV=development
# 4100 (not needleye's 4000) so both projects can run on one machine.
# Most hosts (Railway/Render/Fly) inject PORT instead -- on Railway set
# API_PORT=${{PORT}} when production is set up.
API_PORT=4100
# One origin, or a comma-separated allow-list (exact match, no wildcard) --
# e.g. add the machine's LAN IP for phone testing:
#   CORS_ALLOWED_ORIGIN=http://localhost:3400,http://192.168.1.8:3400
CORS_ALLOWED_ORIGIN=http://localhost:3400
# Origin of the Next.js app. Used server-side to build absolute links the user
# opens elsewhere (the password-reset email link). For phone testing on the
# local network, set this to the machine's LAN IP.
WEB_APP_URL=http://localhost:3400
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Queries slower than this many ms are logged at WARN (slow-query observability).
SLOW_QUERY_MS=250

# Max Postgres pool connections (whole app shares one pool). Main concurrency
# lever -- raise for higher simultaneous load, keep under the DB's limit.
DB_POOL_MAX=10
# The firm's home time zone (IANA name): the default for new users and clients.
# Everyone can pick their own zone; instants are always stored in UTC.
DEFAULT_TIMEZONE=Asia/Kolkata
# Auth-endpoint brute-force protection (in-memory): window length + max attempts
# per IP per window. Applies only to /auth/* (login, refresh, reset, ...).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Express `trust proxy`: how far to trust X-Forwarded-For so the rate limiter
# keys on the real client IP. A hop count ("2"), a preset ("loopback"), or
# "false". Default "loopback" trusts only same-machine proxies (the Next.js
# session proxy in dev). In production this is a HOP COUNT that must match the
# platform exactly (needleye found Railway needs "2") -- verify by sending
# AUTH_RATE_LIMIT_MAX+1 failed logins and confirming the last one returns 429.
# Never "true" (that lets any client spoof its IP).
TRUST_PROXY=loopback

# From `npx supabase@2.119.0 status` (or the `start` output) in local dev.
# SUPABASE_SERVICE_ROLE_KEY is server-only -- never expose it to the client or
# commit it. SUPABASE_ANON_KEY is used by the Auth module for sign-in/refresh/
# password-reset/code-exchange -- also server-only here, since hok-web never
# talks to Supabase directly.
# HOK's local stack uses ports 544xx (needleye uses 543xx).
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Plain Postgres connection string -- every repository's data access goes
# through this via Drizzle (src/common/database/drizzle-client.ts), not through
# Supabase's SDK. The default matches the local Supabase CLI stack's Postgres
# port for HOK (54422). In production: the Supabase *Session-mode* pooler
# (see needleye's ADR 0006 for why).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54422/postgres
